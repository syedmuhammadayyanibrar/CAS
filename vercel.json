{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python build.py",
  "functions": {
    "backend/main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|webhooks/|assets/|docs|redoc|openapi\\.json).*)",
      "has": [{ "type": "header", "key": "accept", "value": "(.*)text/html(.*)" }],
      "destination": "/index.html"
    }
  ]
}
